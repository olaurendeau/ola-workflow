#!/usr/bin/env bash
# Reads the profile of the project this session is working on.
#
# A plugin's bin/ is on the PATH of every Bash call, so agents and hooks can simply run
# `ola-profile get check.affected --slot 3` instead of knowing where profiles live.
set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=hooks/lib/profile.sh
. "$SELF_DIR/../hooks/lib/profile.sh"

usage() {
  cat <<'USAGE'
usage: ola-profile [-C <dir>] [--slot <n>] <command> [args]

commands:
  path                  the profile file in use
  dir                   the directory holding it (in discreet mode, also the agents' memory)
  where [user|project]  where a profile would go, whether one is there or not
  schema                the schema file this CLI validates against
  id                    <host>/<owner>/<repo>, from `git remote get-url upstream || origin`
  mode                  integrated | discreet
  get <key> [default]   one value, dotted path; an array prints one item per line
  show                  the whole profile
  validate [file]       checks a profile against the schema; prints every problem
  help

options:
  -C <dir>     resolve as if run from this directory (default: the current one)
  --slot <n>   replace {slot} in the value printed by `get`

Exit status 1 means the value asked for is not available: no profile applies to this
project (which is not an error, just an opt-out), the profile cannot be read, or `get`
found no such key and no default was given. Status 2 is a usage error.
USAGE
}

dir=$PWD
slot=

# An option whose value is missing must fail, not be shrugged off: `shift 2` with a single
# argument left shifts nothing and returns non-zero, so swallowing that status would spin
# this loop forever — and A3 calls this binary from a PreToolUse hook.
need_value() {
  [ "$1" -ge 2 ] || { echo "ola-profile: $2 needs a value" >&2; exit 2; }
  [ -n "$3" ] || { echo "ola-profile: $2 needs a value" >&2; exit 2; }
}

# Options are read wherever they appear, before the subcommand or after it, and the
# arguments are collected as they come. `--slot` used to be read only *before*, and was
# dropped in silence after — which is the form the README documents and the form a person
# writes:
#
#   ola-profile get check.affected --slot 3
#
# It returned `make check SLOT={slot}`, and an agent ran that literally. Reported from a real
# project. An option that is understood in one position and ignored in the other is worse
# than one that is refused everywhere: the refusal is a message, the silence is a command
# with a brace in it.
ARGS=()
while [ $# -gt 0 ]; do
  case $1 in
    -C) need_value "$#" -C "${2:-}"; dir=$2; shift 2 ;;
    --slot) need_value "$#" --slot "${2:-}"; slot=$2; shift 2 ;;
    -C=*) dir=${1#*=}; [ -n "$dir" ] || { echo "ola-profile: -C needs a value" >&2; exit 2; }; shift ;;
    --slot=*) slot=${1#*=}; [ -n "$slot" ] || { echo "ola-profile: --slot needs a value" >&2; exit 2; }; shift ;;
    -h|--help|help) usage; exit 0 ;;
    # Everything after `--` is an argument, including something that looks like an option:
    # that is what `--` is for, and `get -- --slot` must be able to ask for a key so spelt.
    --) shift; while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done ;;
    -*) echo "ola-profile: unknown option $1" >&2; usage >&2; exit 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

set -- ${ARGS[@]+"${ARGS[@]}"}
[ $# -gt 0 ] || { usage >&2; exit 2; }
command=$1
shift

case $command in
  path) ola_profile_path "$dir" ;;
  dir) ola_profile_dir "$dir" ;;
  # `where` answers before a profile exists, which is what `path` cannot do and what
  # creating the first one needs. With a scope it prints that one path and nothing else, so
  # a caller writing a file never has to pick a line out of a list.
  # So that whoever writes a profile can point an editor at the schema without restating
  # where the plugin keeps it. `validate` already resolves it; this prints the same answer.
  # Status 1 when the file is not there, like every other answer this CLI gives about a
  # value it cannot supply. Printing a path that leads nowhere, successfully, is what sends
  # a caller to write it into a file.
  schema)
    [ -f "$OLA_PROFILE_SCHEMA" ] || {
      echo "ola-profile schema: $OLA_PROFILE_SCHEMA is not there" >&2
      exit 1
    }
    printf '%s\n' "$OLA_PROFILE_SCHEMA" ;;
  where)
    if [ $# -gt 0 ]; then
      case $1 in
        user|project) ;;
        *) echo "ola-profile where: scope is user or project, not '$1'" >&2; exit 2 ;;
      esac
      line=$(ola_profile_candidates "$dir" | grep "^$1 ") || {
        echo "ola-profile where: no $1 path applies here (is this a git repository with a remote?)" >&2
        exit 1
      }
      printf '%s\n' "${line#* }"
    else
      # Status 1 when there is no candidate at all, because that is this CLI's contract for
      # "the value you asked for is not available" — and printing nothing, successfully, is
      # the one answer a caller must never get. Outside a repository it used to do exactly
      # that.
      out=$(ola_profile_candidates "$dir")
      [ -n "$out" ] || exit 1
      printf '%s\n' "$out"
    fi
    ;;
  id) ola_profile_id "$dir" ;;
  mode) ola_profile_mode "$dir" ;;
  get)
    # Checked here rather than passed down: an empty key is a mistake in the caller, not a
    # question about the profile, and letting it reach the accessor would reopen a status
    # the accessor exists to have exactly one of.
    [ $# -gt 0 ] && [ -n "$1" ] ||
      { echo "ola-profile get: a key is required" >&2; exit 2; }
    # The whole policy lives in ola_profile_get: a default stands in for a key the profile
    # does not have, never for a profile that cannot be read. There is nothing left to
    # decide here, which is the point — this `case` used to be where it was decided twice.
    if [ $# -gt 1 ]; then
      ola_profile_get "$1" "$dir" "$slot" "$2" || exit 1
    else
      ola_profile_get "$1" "$dir" "$slot" || exit 1
    fi
    ;;
  show)
    file=$(ola_profile_path "$dir") || exit 1
    # Two messages, because they are two different problems: a file that holds no single
    # JSON value, and valid JSON that is not a profile. Saying "not valid JSON" for an
    # array sends the reader looking for a syntax error that is not there.
    # Keep this order, and keep both calls: that every readable profile also holds one
    # JSON value is now pinned only here, so dropping the first call to "simplify" would
    # silently retire the containment between the two readers.
    ola_profile_holds_json "$file" ||
      { echo "ola-profile: $file: not valid JSON" >&2; exit 1; }
    ola_profile_readable "$file" ||
      { echo "ola-profile: $file: valid JSON, but not an object, so not a profile" >&2; exit 1; }
    jq . "$file"
    ;;
  validate)
    if [ $# -gt 0 ]; then
      ola_profile_validate "$1"
    else
      [ -d "$dir" ] || { echo "ola-profile: $dir: no such directory" >&2; exit 2; }
      ( cd "$dir" && ola_profile_validate )
    fi
    ;;
  *) echo "ola-profile: unknown command $command" >&2; usage >&2; exit 2 ;;
esac
