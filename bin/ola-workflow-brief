#!/usr/bin/env bash
# Prints the rules of the workflow for the project the session is working on, resolved
# against its profile.
#
# This exists so that the rules are written once. Every agent prompt needs the same facts —
# which mode, which branch, which commands, which slots, what this mode forbids, what is
# reserved for the human — and a copy per prompt would drift apart one justified
# edit at a time. So each agent starts by running this, and the prompts hold only what is
# specific to their role.
#
# The words of the brief are not in this script: they are the templates of brief/, one file
# per section, and this script keeps the logic — which section is printed, which value each
# template reads, in what order. A sentence for the reader is edited in brief/, and
# tests/brief.test.sh fails on one that comes back here.
#
# Exit 1 and say so when no profile applies: a project that has not opted into the workflow
# must get a clear refusal, not a set of guessed defaults.
set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=hooks/lib/profile.sh
. "$SELF_DIR/../hooks/lib/profile.sh"

# The templates in brief/ read their values from OLA_BRIEF_* and from nothing else. One this
# script forgot to set must fail the render, not be supplied by the caller's environment.
for inherited in $(compgen -e); do
  case $inherited in OLA_BRIEF_*) unset "$inherited" ;; esac
done

dir=${1:-$PWD}

# get <key> [default]
# The default policy lives in ola_profile_get, so there is nothing to decide here. A
# missing default simply prints nothing, and a profile that cannot be read was already
# refused above — whichever way, this cannot invent a value.
get() {
  if [ $# -gt 1 ]; then
    printf '%s' "$(ola_profile_get "$1" "$dir" "" "$2")"
  else
    printf '%s' "$(ola_profile_get "$1" "$dir" "")"
  fi
}

# The refusals are rules too (brief/refusals/), and are rendered before the helpers below
# exist: this one is the only helper they need.
render() { # render <section> → brief/<section>.md, or the end of the brief
  if ! awk -f "$SELF_DIR/../hooks/lib/brief-render.awk" "$SELF_DIR/../brief/$1.md"; then
    echo "ola-workflow-brief: brief/$1.md could not be rendered" >&2
    exit 2
  fi
}

unreadable() {
  render refusals/unreadable >&2
  exit 1
}

profile=$(ola_profile_path "$dir") || {
  render refusals/no-profile >&2
  exit 1
}
ola_profile_readable "$profile" || unreadable
mode=$(ola_profile_mode "$dir")

# A value the profile does not state is a plugin default, and it must say so. Unmarked, a
# reviewer rejects an 1,100-line change on a budget nobody set, and a developer branches
# from main in a repository whose branch is master.
DEFAULTED=""
defaulted() { # defaulted <key> <value> → the value, and remember it was not declared
  DEFAULTED="$DEFAULTED $1"
  printf '%s' "$2"
}
with_default() { # with_default <key> <default>
  if ola_profile_has "$1" "$dir"; then
    ola_profile_get "$1" "$dir" "" | tr -d '\n'
  else
    defaulted "$1" "$2"
  fi
}

# The base branch is the one default worth resolving rather than guessing: the repository
# knows which branch it belongs to.
base_from_origin=""
base_guessed=""
if ! base=$(ola_profile_get base_branch "$dir" 2>/dev/null); then
  resolved=$(git -C "$dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -n "$resolved" ]; then
    base=${resolved#origin/}
    base_from_origin=1
    DEFAULTED="$DEFAULTED base_branch"
  else
    base=main
    base_guessed=1
    DEFAULTED="$DEFAULTED base_branch"
  fi
fi

# Probed before anything is printed, so that what is not the project's own is said before
# the rules rather than after them. A rule read first and qualified later has already been
# believed.
MISSING=""
# key=default, so the notice can say what the value is: the agent's decision is about the
# value, and "pr.max_lines" alone does not tell it what budget not to enforce.
for pair in language.human=en language.artifacts=en language.agents=en \
            pr.max_lines=1000 pr.title=conventional merge.review_status=agent-review \
            slots.var=SLOT; do
  ola_profile_has "${pair%%=*}" "$dir" || MISSING="$MISSING $pair"
done
[ -n "$base_from_origin$base_guessed" ] && MISSING="$MISSING base_branch=$base"

# A preview is usable only whole: one that cannot be stopped keeps its slot, and without a
# url there is nothing to capture. A partial one — the schema check above says so — is
# treated as absent, rather than printed with a blank where a command should be.
preview=
if [ -n "$(get preview.up)" ] && [ -n "$(get preview.url)" ] && [ -n "$(get preview.down)" ]; then
  preview=1
fi

# Everything printed from here on is held back and written at the end: a template that
# cannot be rendered leaves nothing on stdout, and the brief is read whole or not at all.
OUT=$(mktemp "${TMPDIR:-/tmp}/ola-brief.XXXXXX") && [ -n "$OUT" ] || {
  echo "ola-workflow-brief: cannot create a temporary file" >&2
  exit 2
}
trap 'rm -f "$OUT"' EXIT
exec 3>&1 >"$OUT"

# The text of the brief is in brief/*.md. Bash decides what is true and what the values are;
# the words are the templates'.
value() { # value <name> <string> → OLA_BRIEF_<name>, exactly as given and never evaluated
  export "OLA_BRIEF_$1=$2"
}
flag() { # flag <name> <command...> → 1 when the command succeeds, empty when it does not
  local name=$1
  shift
  if "$@"; then value "$name" 1; else value "$name" ""; fi
}
read_key() { # read_key <dotted.key> [join] → <key, . as _> and <key>_absent; join: one line
  local name=${1//./_} v
  if v=$(ola_profile_get "$1" "$dir" ""); then
    [ "${2-}" = join ] && v=${v//$'\n'/ }
    value "$name" "$v"
    value "${name}_absent" ""
  else
    value "$name" ""
    value "${name}_absent" 1
  fi
}

# What several sections share.
value base "$base"
flag integrated [ "$mode" = integrated ]
flag discreet [ "$mode" != integrated ]
flag preview [ -n "$preview" ]
flag tokens_off [ "$(with_default github_tokens keychain)" = off ]
flag tokens_on [ "$(with_default github_tokens keychain)" != off ]
value language_artifacts "$(with_default language.artifacts en)"
value review_status "$(with_default merge.review_status agent-review)"

# The header: the problems are indented here, the words around them are the template's.
schema_mismatch=""
problems_indented=""
if ! problems=$(ola_profile_validate "$profile" 2>&1) || [ -n "$problems" ]; then
  schema_mismatch=1
  problems_indented=$(printf '%s\n' "$problems" | sed 's/^/  /')
fi
missing_lines=""
for pair in $MISSING; do
  printf -v line '  %s → %s' "${pair%%=*}" "${pair#*=}"
  missing_lines="${missing_lines:+$missing_lines$'\n'}$line"
done
value profile "$profile"
value mode "$mode"
flag schema_mismatch [ -n "$schema_mismatch" ]
value problems_indented "$problems_indented"
flag missing_any [ -n "$MISSING" ]
value missing_lines "$missing_lines"
flag base_from_origin [ -n "$base_from_origin" ]
flag base_guessed [ -n "$base_guessed" ]
render header; echo
value language_human "$(with_default language.human en)"
value language_agents "$(with_default language.agents en)"
render languages; echo
read_key check.full
read_key check.affected
read_key check.cleanup
render commands; echo
value slots_var "$(with_default slots.var SLOT)"
read_key slots.developers join
read_key slots.reviewer join
render slots; echo
# Which changes are worth a security review is the project's to say, and whether a change
# touches one is git's: the same pathspec dialect as every other glob here, matched by the
# command that reads the diff rather than by an agent reading a list.
security_paths=$(get security.paths)
pathspec=""
if [ -n "$security_paths" ]; then
  while IFS= read -r glob; do pathspec="$pathspec ':(glob)$glob'"; done <<<"$security_paths"
fi
value pathspec "$pathspec"
flag security_declared [ -n "$security_paths" ]
flag security_none [ -z "$security_paths" ]
render security-review; echo
value pr_max_lines "$(with_default pr.max_lines 1000)"
read_key pr.exclude join
flag title_conventional [ "$(with_default pr.title conventional)" = conventional ]
flag title_free [ "$(with_default pr.title conventional)" != conventional ]
render pull-request; echo
extra=$(get escalation_extra)
[ -n "$extra" ] && extra=$(printf '%s\n' "$extra" | sed 's/^/- /')
value escalation_extra "$extra"
render escalation; echo
# What GitHub itself refuses, read from the profile like everything else. An agent has to know
# whether a rule it is about to break will stop it: told it will be refused and seeing no
# refusal, it reads the silence as sanction — which is why this section exists and why
# tests/agents.test.sh ties what it says to the key.
tokens=$(with_default github_tokens keychain)
[ "$tokens" = off ] || [ "$mode" = integrated ] || tokens=discreet
case $tokens in
  discreet) render what-stops-you.discreet ;;
  off) render what-stops-you.off ;;
  *) render what-stops-you.keychain ;;
esac
echo
# Each element is read by one jq pass over all of them, with jq's own truth: `.reason // …`
# keeps a reason of "", and `if .allow_args` takes "" for true, which a test of the shell on
# an empty string would not. Three fields per element, each ended by a NUL, so that a value
# ending in a newline survives. jq stops at the first element it cannot read and says so once
# on stderr, as it did when it printed the lines itself; the elements before it are kept.
# The reason comes last because jq evaluates an interpolation from its last part, and the
# error it names is the first one it meets. A NUL inside a cmd or a reason would end its field
# early and shift every one after it, so it is dropped there, by jq, before it is emitted.
restricted=$(get commands)
commands_list=""
if [ -n "$restricted" ]; then
  while IFS= read -r -d '' kind && IFS= read -r -d '' cmd && IFS= read -r -d '' reason; do
    value cmd "$cmd"
    value reason "$reason"
    flag reason_given [ "$kind" = given ]
    flag args_allowed [ "$kind" = allowed ]
    flag args_refused [ "$kind" = refused ]
    item=$(render items/restricted-command && printf .) || exit 2
    commands_list="$commands_list${item%.}"
  done < <(printf '%s' "$restricted" | jq -j 'def clean: tostring | gsub("\u0000"; ""); .[] |
    "\(if .reason then "given" elif .allow_args then "allowed" else "refused" end)\u0000\(.cmd | clean)\u0000\(.reason // "" | clean)\u0000"')
  commands_list=${commands_list%$'\n'}
fi
flag commands_none [ -z "$restricted" ]
value commands_list "$commands_list"
read_key db_hosts_allowed join
render restricted-commands; echo
ui_kind=$(get verify_ui.kind)
if [ -n "$ui_kind" ]; then
  # A step is a line of the section only when the profile gives it; the section itself, and
  # the blank line that ends it, only when there is a kind to name.
  for step in kind up test shot down; do
    read_key "verify_ui.$step"
  done
  render seeing-it-run; echo
fi
# What a change looks like is shown by a capture, and whether one can be taken is the
# profile's to say: the roles cite this section for when to capture and the brief says how.
if [ -n "$preview" ]; then
  for step in up url down; do
    read_key "preview.$step"
  done
  render captures.preview
else
  render captures.none
fi
echo
# Rules every role needs, so they are written here once rather than in each prompt. Static
# on purpose: nothing in the profile changes them, and both modes print them.
render keeping-context-small; echo
# Whether any of the five is declared decides the line that says none is.
context_found=
for key in product architecture review_checklist security_precedents glossary; do
  read_key "context.$key"
  [ -n "$(get "context.$key")" ] && context_found=1
done
flag context_none [ -z "$context_found" ]
render context; echo

# Visual work is published as a claude.ai artifact, which is the one thing that leaves the
# machine on purpose — so where it is documented, where its page is written, and whether it
# may be published at all are the mode's to say, not the product-designer's.
if [ "$mode" = integrated ]; then
  # The default is announced here rather than in the notice above: a project with no
  # interface has no reason to set it, and would otherwise open every brief on it.
  read_key context.design
  design_dir=$(ola_profile_get context.design "$dir" 2>/dev/null) || design_dir=docs/design
  value design_dir "${design_dir%/}"
  # Not under TMPDIR: until a developer copies them, the page and its README are the only
  # record of the designer's decisions and of the review verdicts, and a reboot wipes TMPDIR.
  stage_id=$(ola_profile_id "$dir" 2>/dev/null) || stage_id=$(basename "$(ola_profile_toplevel "$dir" 2>/dev/null || printf '%s' "$dir")")
  value stage_id "$stage_id"
  value home "$HOME"
  render design.integrated
else
  value profile_dir "$(ola_profile_dir "$dir")"
  render design.discreet
fi
echo

if [ "$mode" = integrated ]; then
  # Each required check is one line of the list; declared empty is a blank line, not a
  # "(none declared)", and an absent one is the template's to say.
  read_key merge.required_checks
  required=$(get merge.required_checks)
  required_checks_list=""
  if [ -n "$required" ]; then
    while IFS= read -r check; do
      value check "$check"
      item=$(render items/required-check && printf .) || exit 2
      required_checks_list="$required_checks_list${item%.}"
    done <<<"$required"
    required_checks_list=${required_checks_list%$'\n'}
  fi
  value required_checks_list "$required_checks_list"
  read_key merge.sensitive_paths join
  render memory.integrated
else
  value profile_dir "$(ola_profile_dir "$dir")"
  # Discreet mode gives no command a stronger token, so with the tokens on GitHub refuses a
  # merge and a status to every role here: that is what the tokens_on paragraph of the
  # template says, and tokens_off is the one that says nothing refuses.
  render memory.discreet
fi

exec 1>&3 3>&-
cat "$OUT"
