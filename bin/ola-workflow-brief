#!/usr/bin/env bash
# Prints the rules of the workflow for the project the session is working on, resolved
# against its profile.
#
# This exists so that the rules are written once. Six agent prompts need the same facts —
# which mode, which branch, which commands, which slots, what this mode forbids, what is
# reserved for the human — and six copies of those facts would drift apart one justified
# edit at a time. So each agent starts by running this, and the prompts hold only what is
# specific to their role.
#
# Exit 1 and say so when no profile applies: a project that has not opted into the workflow
# must get a clear refusal, not a set of guessed defaults.
set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=hooks/lib/profile.sh
. "$SELF_DIR/../hooks/lib/profile.sh"

dir=${1:-$PWD}

# get <key> [default]
# The default policy lives in ola_profile_get, so there is nothing to decide here. A
# missing default simply prints nothing, and a profile that cannot be read was already
# refused above — whichever way, this cannot invent a value.
get() {
  if [ $# -gt 1 ]; then
    printf '%s' "$(ola_profile_get "$1" "$dir" "" "$2")"
  else
    printf '%s' "$(ola_profile_get "$1" "$dir" "")"
  fi
}

unreadable() {
  cat >&2 <<'BROKEN'
This project has a profile, and it cannot be read.

Do not carry on with defaults: a profile that is truncated, empty or not a JSON object
would otherwise produce a complete-looking set of rules, every one of them invented — a
base branch the project does not have, a check command nobody runs. Tell the human which
file it is and that it needs fixing; `ola-profile validate` says what is wrong with it.
BROKEN
  exit 1
}

profile=$(ola_profile_path "$dir") || {
  cat >&2 <<'NOPROFILE'
No ola-workflow profile applies to this project, so the workflow does not apply either.

Nothing is wrong: the plugin stays out of the way until a project opts in. Tell the human
this, and offer to run /ola-workflow:workflow-init, which inspects the repository and writes
a profile. Do not guess a branch, a check command or a mode — a wrong guess here is how an
agent pushes to the wrong branch or writes on a repository that did not ask for it.
NOPROFILE
  exit 1
}
ola_profile_readable "$profile" || unreadable
mode=$(ola_profile_mode "$dir")

# A value the profile does not state is a plugin default, and it must say so. Unmarked, a
# reviewer rejects an 1,100-line change on a budget nobody set, and a developer branches
# from main in a repository whose branch is master.
DEFAULTED=""
defaulted() { # defaulted <key> <value> → the value, and remember it was not declared
  DEFAULTED="$DEFAULTED $1"
  printf '%s' "$2"
}
with_default() { # with_default <key> <default>
  if ola_profile_has "$1" "$dir"; then
    ola_profile_get "$1" "$dir" "" | tr -d '\n'
  else
    defaulted "$1" "$2"
  fi
}

# The base branch is the one default worth resolving rather than guessing: the repository
# knows which branch it belongs to.
if base=$(ola_profile_get base_branch "$dir" 2>/dev/null); then
  base_note=""
else
  resolved=$(git -C "$dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -n "$resolved" ]; then
    base=${resolved#origin/}
    base_note=" (not in the profile — read from origin/HEAD)"
    DEFAULTED="$DEFAULTED base_branch"
  else
    base=main
    base_note=" (not in the profile, and origin/HEAD says nothing — a guess)"
    DEFAULTED="$DEFAULTED base_branch"
  fi
fi

# Probed before anything is printed, so that what is not the project's own is said before
# the rules rather than after them. A rule read first and qualified later has already been
# believed.
MISSING=""
# key=default, so the notice can say what the value is: the agent's decision is about the
# value, and "pr.max_lines" alone does not tell it what budget not to enforce.
for pair in language.human=en language.artifacts=en language.agents=en \
            pr.max_lines=1000 pr.title=conventional merge.review_status=agent-review \
            slots.var=SLOT; do
  ola_profile_has "${pair%%=*}" "$dir" || MISSING="$MISSING $pair"
done
[ -n "$base_note" ] && MISSING="$MISSING base_branch=$base"

echo "# ola-workflow — the rules for this project"
echo
echo "Profile: $profile"
echo "Mode:    $mode"

if ! problems=$(ola_profile_validate "$profile" 2>&1) || [ -n "$problems" ]; then
  echo
  echo "## This profile does not match the schema"
  echo
  echo "Read what follows with that in mind, and tell the human. A key spelled wrong is a"
  echo "key that is not there, so a rule you are about to read may be a default of mine"
  echo "standing in for one this project meant to set:"
  echo
  printf '%s\n' "$problems" | sed 's/^/  /'
fi

if [ -n "$MISSING" ]; then
  echo
  echo "## Not in the profile — these are my defaults, not this project's rules"
  echo
  for pair in $MISSING; do printf '  %s → %s\n' "${pair%%=*}" "${pair#*=}"; done
  echo
  echo "Treat them as a question to ask rather than a decision to enforce. Rejecting a"
  echo "change for breaking a budget nobody set is worse than not having a budget."
fi
echo "Base branch: $base$base_note — nobody pushes to it, every change arrives by"
echo "pull request."
echo
echo "## Languages"
echo "To the human:        $(with_default language.human en)"
echo "Issues, PRs, commits, reviews: $(with_default language.artifacts en)"
echo "Agent to agent:      $(with_default language.agents en)"
echo
echo "## Commands"
printf 'Everything CI runs:  %s\n' "$(get check.full '(none declared — ask the human what proves this project works)')"
if affected=$(ola_profile_get check.affected "$dir" 2>/dev/null); then
  printf 'The affected subset: %s\n' "$affected"
else
  printf 'The affected subset: %s — the same command: this project declares no subset.\n' \
    "$(get check.full '(none declared)')"
fi
cleanup=$(get check.cleanup)
[ -n "$cleanup" ] && printf 'After a check:        %s\n' "$cleanup"
echo
echo "Any {slot} in those commands is replaced by the slot you were given. Read a value"
echo "with the slot already substituted: ola-profile get check.affected --slot <n>"
echo
echo "## Slots"
printf 'Variable: %s · developers: %s · reviewer: %s\n' \
  "$(with_default slots.var SLOT)" \
  "$(get slots.developers '(none declared)' | tr '\n' ' ')" \
  "$(get slots.reviewer '(none declared)')"
echo "A slot is what keeps parallel work from colliding on ports, databases and containers."
echo "Never run a command with another agent's slot."
echo
echo "## A reviewable pull request"
printf 'At most %s changed lines' "$(with_default pr.max_lines 1000)"
excluded=$(get pr.exclude)
[ -n "$excluded" ] && printf ', excluding %s' "$(printf '%s' "$excluded" | tr '\n' ' ')"
echo "."
case $(with_default pr.title conventional) in
  conventional) echo "Title in Conventional Commits form: it becomes the commit message on $base." ;;
  *) echo "Title: no imposed form." ;;
esac
echo
echo "## Escalation — what belongs to the human"
cat <<'BASE'
- Scope and product: what a user sees, departing from what was asked.
- Dependencies: adding a runtime dependency, any major version upgrade.
- Process and security: CI, rulesets, quality thresholds, hooks, agent definitions.
- Release: whether to release, and the version. The release itself is the human's act.
BASE
extra=$(get escalation_extra)
[ -n "$extra" ] && printf '%s\n' "$extra" | sed 's/^/- /'
echo
echo "Anything else, decide yourself and favour the option closest to existing code."
echo "Record a decision where the work lives: Decision: … — Reason: …"
echo
# What GitHub itself refuses, read from the profile like everything else. An agent has to know
# whether a rule it is about to break will stop it: told it will be refused and seeing no
# refusal, it reads the silence as sanction — which is why this section exists and why
# tests/agents.test.sh ties what it says to the key.
echo "## What stops you"
review_status=$(with_default merge.review_status agent-review)
tokens=$(with_default github_tokens keychain)
[ "$tokens" = off ] || [ "$mode" = integrated ] || tokens=discreet
case $tokens in
  discreet)
    cat <<'DISCREET_STOPS'
GitHub refuses merging a pull request and writing a commit status to every role in this
project, however the command is written: every Bash command runs with a GitHub token that can
do neither, and in discreet mode no command gets a stronger one. What else this mode forbids
is in its own section below, and nothing refuses that.
DISCREET_STOPS
    ;;
  off)
    cat <<'NOTHING'
Nothing. This project's profile turns the role tokens off, so you work with the human's own
GitHub login and every right it has. Every rule above is a rule you apply yourself, and
silence is not permission — it only means nobody switched the refusals on.
NOTHING
    ;;
  *)
    cat <<ENFORCED
GitHub refuses **two** operations to every role but the one that owns them, however the
command is written — \`gh\`, \`gh api\`, a script, \`curl\`:
- merging a pull request, to anyone but the coordinator;
- writing a commit status, to anyone but the pr-reviewer.

Every Bash command runs with a GitHub token that can do neither. Two commands, in one exact
form each, run with a stronger one — nothing may come before, after or around them, and the
SHA is the full 40 characters:

    coordinator  gh pr merge <N> --squash --match-head-commit <SHA>
    pr-reviewer  gh api repos/{owner}/{repo}/statuses/<SHA> -f state=<success|failure> -f context=$review_status -f description='<one line>'

- A 403 on one of these means you are not the role that owns it, or the form is not exactly
  this one. Report it; do not look for another way or another token.
- A 401 on every gh call means the human has not created the tokens yet. Say so: they run
  \`ola-workflow-tokens setup\`.

**Everything else above is a rule nothing applies.** Pushing to the base branch — \`git push\`
uses the human's own credentials — tagging, releasing, publishing, changing repository
settings: they hold only as far as you hold them. Do not read the absence of a refusal as
permission; on those, you are the enforcement.
ENFORCED
    ;;
esac
echo
echo "## Restricted commands"
restricted=$(get commands)
if [ -n "$restricted" ]; then
  printf '%s' "$restricted" | jq -r '.[] | "- \(.cmd): \(.reason // (if .allow_args then "only some arguments are allowed" else "some arguments are refused" end))"'
else
  echo "(none declared)"
fi
hosts=$(get db_hosts_allowed)
if [ -n "$hosts" ]; then
  printf -- '- a database: only at %s. Anything else is production until proven otherwise.\n' \
    "$(printf '%s' "$hosts" | tr '\n' ' ')"
fi
echo "Anything else is out of bounds. Knowing it in advance saves a cycle; it is not an"
echo "invitation to find out where the boundary is by walking into it."
echo
ui_kind=$(get verify_ui.kind)
if [ -n "$ui_kind" ]; then
  echo "## Seeing it run"
  printf 'This project can be looked at (%s). Use it when looking is the only proof:\n' "$ui_kind"
  for step in up test shot down; do
    value=$(get "verify_ui.$step")
    [ -n "$value" ] && printf '  %-5s %s\n' "$step" "$value"
  done
  echo "Run down whatever the result, and remember {slot} applies here too."
  echo
fi
echo "## Context — read these before writing anything"
found=0
for key in product architecture review_checklist glossary; do
  path=$(get "context.$key")
  if [ -n "$path" ]; then
    printf '%-18s %s\n' "$key:" "$path"
    found=1
  fi
done
[ "$found" = 0 ] && echo "(none declared — the repository itself is the only source)"
echo

# Visual work is published as a claude.ai artifact, which is the one thing that leaves the
# machine on purpose — so where it is documented, where its page is written, and whether it
# may be published at all are the mode's to say, not the product-designer's.
echo "## Design — visual work"
if [ "$mode" = integrated ]; then
  # The default is announced here rather than in the notice above: a project with no
  # interface has no reason to set it, and would otherwise open every brief on it.
  if design_dir=$(ola_profile_get context.design "$dir" 2>/dev/null); then
    design_note=""
  else
    design_dir=docs/design
    design_note=" (not in the profile — my default)"
  fi
  design_dir=${design_dir%/}
  # Not under TMPDIR: until a developer copies them, the page and its README are the only
  # record of the designer's decisions and of the review verdicts, and a reboot wipes TMPDIR.
  stage_id=$(ola_profile_id "$dir" 2>/dev/null) || stage_id=$(basename "$(ola_profile_toplevel "$dir" 2>/dev/null || printf '%s' "$dir")")
  cat <<DESIGN
Documented in:    $design_dir/<slug>/$design_note
                  index.html, the page; README.md, its artifact URL, what it shows, its
                  words, its decisions and its revisions.
Written first in: ${HOME}/.claude/ola-workflow-design/$stage_id/<slug>/
                  outside the repository. A developer's task copies it into
                  $design_dir/<slug>/.
Publishing:       allowed for visual work. One artifact per design: a design that already
                  has a URL is republished at that URL, never published again.
DESIGN
else
  cat <<DESIGN
Documented in:    $(ola_profile_dir "$dir")/runs/<slug>/design/
                  nothing goes into the repository.
Publishing:       only after the human has said yes to this design, relayed by the
                  coordinator. An artifact sends the page to claude.ai, and this project
                  did not ask for its contents to leave the machine.
DESIGN
fi
echo

if [ "$mode" = integrated ]; then
  cat <<INTEGRATED
## Memory — integrated mode

The forge is the memory. An epic is a GitHub issue labelled \`epic\`, a task is an issue
labelled \`task\`, a review is a PR comment plus a commit status. Nothing important lives
only in an agent's report: if it matters tomorrow, it is written on an issue or a PR today.

## Merging — integrated mode

Checked on the forge for the PR's current head SHA, never taken from a report:
$(req=$(get merge.required_checks '(none declared)'); printf '%s' "$req" | sed 's/^/- check: /')
- status $(with_default merge.review_status agent-review) successful on that same SHA
- the branch is not behind $base
- no file touched under: $(get merge.sensitive_paths '(none declared)' | tr '\n' ' ')
- no sensitive pattern in the patch

Then, in exactly this form, with the full SHA you checked:

    gh pr merge <N> --squash --match-head-commit <SHA>

A file in a sensitive path, or a sensitive pattern in the patch, means the human merges.
Say so and stop; do not look for a way around it.
INTEGRATED
else
  profile_dir=$(ola_profile_dir "$dir")
  # Discreet mode gives no command a stronger token, so with the tokens on GitHub refuses a
  # merge and a status to every role here.
  if [ "$(with_default github_tokens keychain)" = off ]; then
    discreet_stops="Nothing refuses any of it here: silence is not permission, you are the
enforcement."
  else
    discreet_stops="GitHub refuses a merge and a commit status here to every role, the
coordinator and the pr-reviewer included. The rest of this section — an issue, a comment,
a label, a push, a pull request — nothing refuses: silence is not permission, you are the
enforcement."
  fi
  cat <<DISCREET
## Memory — discreet mode

This project did not ask for the workflow, so the workflow leaves no trace in it. The
memory is local, under:

  $profile_dir/runs/<slug>/

with epic.md, tasks/ and reviews/<sha>.md. Keep the repository itself clean: git status
must be as you found it.

## What discreet mode forbids

- Changing anything on the forge, in any direction: creating, editing, deleting, closing,
  reopening, labelling or unlabelling an issue, a comment, a review, a commit status, a
  release. Reading is free — and that is the whole of what is free.
- Merging. Nobody merges, the coordinator included.

And two actions need the human to confirm, because they are the only ones other
contributors see: pushing a branch, and opening a pull request. Propose them, explain what
they will contain, and wait for an answer.

Wait for it even if nothing interrupts you. $discreet_stops
DISCREET
fi
