{
  "description": "ola-workflow: PreToolUse guard for Bash calls",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
